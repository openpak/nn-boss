# nn-boss: BOSS / SpotPass for Wii U and 3DS, over the OpenPak Wii U/3DS adapter (nn-account)
# and friends (nn-friends). Copy to .env; never commit .env.
PN_BOSS_CONFIG_HTTP_PORT=20080
PN_BOSS_CONFIG_LOG_FORMAT=json
PN_BOSS_CONFIG_LOG_LEVEL=info
PN_BOSS_CONFIG_MONGO_CONNECTION_STRING=mongodb://openpak-mongo:27017/boss
# Content store: S3 (MinIO) or a disk path.
PN_BOSS_CONFIG_S3_ENDPOINT=http://openpak-minio:9000
PN_BOSS_CONFIG_S3_REGION=us-east-1
PN_BOSS_CONFIG_S3_BUCKET=boss
PN_BOSS_CONFIG_S3_ACCESS_KEY=
PN_BOSS_CONFIG_S3_ACCESS_SECRET=
#PN_BOSS_CONFIG_CDN_DISK_PATH=/data/cdn
# Console-dumped keys (BetterKeyDumper). Without them no SpotPass content can be signed.
PN_BOSS_CONFIG_BOSS_WIIU_AES_KEY=
PN_BOSS_CONFIG_BOSS_WIIU_HMAC_KEY=
PN_BOSS_CONFIG_BOSS_3DS_AES_KEY=
# The Wii U/3DS adapter's account.v2 gRPC and the friends gRPC.
PN_BOSS_CONFIG_GRPC_ACCOUNT_SERVER_ADDRESS=openpak-nn-account
PN_BOSS_CONFIG_GRPC_ACCOUNT_SERVER_PORT=20051
PN_BOSS_CONFIG_GRPC_ACCOUNT_SERVER_API_KEY=
PN_BOSS_CONFIG_GRPC_FRIENDS_SERVER_ADDRESS=openpak-nn-friends
PN_BOSS_CONFIG_GRPC_FRIENDS_SERVER_PORT=20061
PN_BOSS_CONFIG_GRPC_FRIENDS_SERVER_API_KEY=
# This service's own gRPC (task/file management CLI).
PN_BOSS_CONFIG_GRPC_BOSS_SERVER_ADDRESS=0.0.0.0
PN_BOSS_CONFIG_GRPC_BOSS_SERVER_PORT=20081
PN_BOSS_CONFIG_GRPC_BOSS_SERVER_API_KEY=
# The BOSS hostnames the console is redirected to (Nintendo's own names on OpenPak).
PN_BOSS_CONFIG_DOMAINS_NPDI=npdi.cdn.nintendowifi.net
PN_BOSS_CONFIG_DOMAINS_NPDL=npdl.cdn.nintendowifi.net
PN_BOSS_CONFIG_DOMAINS_NPFL=npfl.c.app.nintendowifi.net
PN_BOSS_CONFIG_DOMAINS_NPPL=nppl.app.nintendowifi.net
PN_BOSS_CONFIG_DOMAINS_NPTS=npts.app.nintendowifi.net
PN_BOSS_CONFIG_DOMAINS_SPR=service.spotpass.nintendowifi.net
PN_BOSS_CONFIG_STREETPASS_RELAY_ENABLED=true
